# Safe local configuration template for FlowGuard AI
# Copy this file to .env and adjust values for your environment.

APP_NAME=flowguard-ai
APP_ENV=development
DEBUG=true

# Backend
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Dataset
DATA_DIR=./data
TRAFFIC_TRAIN_FILE=traffic_train.csv
FORECAST_TARGETS_TRAIN_FILE=forecast_targets_train.csv
TRAFFIC_VALIDATION_FILE=traffic_validation.csv
FORECAST_TARGETS_VALIDATION_FILE=forecast_targets_validation.csv

# Model artifacts
MODEL_DIR=./models
FORECAST_MODEL_PATH=./models/forecast_model.pt
INCIDENT_MODEL_PATH=./models/incident_model.joblib

# Forecasting
FORECAST_HORIZONS_MINUTES=15,30,45,60
LOOKBACK_STEPS=12
TIME_INTERVAL_MINUTES=5

# Decision engine
K_SHORTEST_PATHS=5
MAX_PROPAGATION_HOPS=3
CONFIDENCE_THRESHOLD=0.70

# Optional persistence
DATABASE_URL=sqlite:///./flowguard.db

# Optional cache
REDIS_URL=

# Optional experiment tracking
MLFLOW_TRACKING_URI=

# Optional LLM integration
LLM_API_KEY=
LLM_MODEL=

# Runtime safety
ALLOW_EXTERNAL_NETWORK=false
SIMULATION_ONLY=true
